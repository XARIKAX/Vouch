pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import {ScoreLib} from "../src/ScoreLib.sol";

/// @dev Replays the histories in test/vectors/score.json (generated by the engine's
/// src/credit/score.js via `npm run credit:vectors`) through ScoreLib and asserts
/// the Solidity score equals the JavaScript score at every checkpoint. This is the
/// parity proof between what the engine shows and what the chain computes.
contract VectorsTest is Test {
    using ScoreLib for ScoreLib.Report;
    ScoreLib.Report internal r;

    function test_parityWithEngineScore() public {
        string memory json = vm.readFile(string.concat(vm.projectRoot(), "/test/vectors/score.json"));
        uint256 count = vm.parseJsonUint(json, ".count");
        assertGt(count, 10, "vectors present");
        for (uint256 v = 0; v < count; v++) {
            delete r;
            string memory base = string.concat(".vectors[", vm.toString(v), "]");
            uint256 n = vm.parseJsonUint(json, string.concat(base, ".n"));
            for (uint256 i = 0; i < n; i++) {
                string memory e = string.concat(base, ".events[", vm.toString(i), "]");
                bytes32 kind = keccak256(bytes(vm.parseJsonString(json, string.concat(e, ".kind"))));
                uint128 amount = uint128(vm.parseJsonUint(json, string.concat(e, ".amount")));
                uint64 ts = uint64(vm.parseJsonUint(json, string.concat(e, ".ts")));
                if (kind == keccak256("settlement")) r.addSettlement(amount, ts);
                else if (kind == keccak256("slash")) r.addSlash(amount);
                else if (kind == keccak256("dispute_loss")) r.addDisputeLoss(amount);
                else if (kind == keccak256("repayment")) {
                    r.addRepayment(amount, uint64(vm.parseJsonUint(json, string.concat(e, ".days"))), vm.parseJsonBool(json, string.concat(e, ".on_time")));
                } else if (kind == keccak256("advance_repayment")) r.addAdvanceRepayment(amount);
                else if (kind == keccak256("default")) r.addDefault(amount, ts);
                else if (kind == keccak256("recovery")) r.addRecovery(amount, ts);
                else revert("unknown kind");
            }
            uint256 m = vm.parseJsonUint(json, string.concat(base, ".m"));
            for (uint256 j = 0; j < m; j++) {
                string memory c = string.concat(base, ".checks[", vm.toString(j), "]");
                uint256 nowTs = vm.parseJsonUint(json, string.concat(c, ".now"));
                uint256 expected = vm.parseJsonUint(json, string.concat(c, ".score"));
                assertEq(r.score(nowTs), expected, string.concat("vector ", vm.toString(v), " check ", vm.toString(j)));
            }
        }
    }
}
